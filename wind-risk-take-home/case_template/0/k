FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

kInlet          0.375;

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $kInlet;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $kInlet;
    }
    outlet
    {
        type            zeroGradient;
    }
    ground
    {
        type            kqRWallFunction;
        value           uniform $kInlet;
    }
    buildings
    {
        type            kqRWallFunction;
        value           uniform $kInlet;
    }
    house
    {
        type            kqRWallFunction;
        value           uniform $kInlet;
    }
    sides
    {
        type            slip;
    }
    top
    {
        type            slip;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}
